FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Tehran

# ============================================
# 🔧 نصب ابزارهای پایه
# ============================================
RUN apt update -y && apt install -y \
    curl wget git sudo net-tools iproute2 \
    openssh-server openvpn wireguard \
    build-essential cmake pkg-config \
    python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

# ============================================
# 🌐 نصب وب‌سرور
# ============================================
RUN apt update -y && apt install -y \
    apache2 php8.1 libapache2-mod-php8.1 \
    php8.1-cli php8.1-common php8.1-mbstring \
    php8.1-curl php8.1-xml php8.1-zip \
    php8.1-mysql php8.1-gd php8.1-bcmath \
    mariadb-server composer \
    && rm -rf /var/lib/apt/lists/*

# ============================================
# 📁 ساخت فولدرهای ضروری
# ============================================
RUN mkdir -p /dev/net \
    && mknod /dev/net/tun c 10 200 \
    && chmod 600 /dev/net/tun \
    && mkdir -p /var/run/sshd \
    && mkdir -p /root/.ssh \
    && chmod 700 /root/.ssh

# ============================================
# 🔑 تنظیم SSH
# ============================================
RUN sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config \
    && sed -i 's/PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config \
    && sed -i 's/#PasswordAuthentication yes/PasswordAuthentication yes/' /etc/ssh/sshd_config \
    && sed -i 's/PasswordAuthentication no/PasswordAuthentication yes/' /etc/ssh/sshd_config

# ============================================
# 🛡️ تنظیم فایروال
# ============================================
RUN apt update -y && apt install -y ufw \
    && ufw allow 22/tcp \
    && ufw allow 80/tcp \
    && ufw allow 443/tcp \
    && ufw allow 1194/udp \
    && ufw allow 51820/udp \
    && ufw --force enable

# ============================================
# 📦 نصب Cloudflared
# ============================================
RUN curl -sL https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64 -o /usr/local/bin/cloudflared \
    && chmod +x /usr/local/bin/cloudflared

# ============================================
# ⚙️ تنظیم Apache
# ============================================
RUN a2enmod rewrite ssl \
    && service apache2 start

# ============================================
# 🗄️ تنظیم MariaDB
# ============================================
RUN service mariadb start \
    && mysql -e "CREATE DATABASE IF NOT EXISTS mirza_pro CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;" \
    && mysql -e "CREATE USER IF NOT EXISTS 'mirza_user'@'localhost' IDENTIFIED BY 'Mirza@2026!Secure';" \
    && mysql -e "GRANT ALL PRIVILEGES ON mirza_pro.* TO 'mirza_user'@'localhost';" \
    && mysql -e "FLUSH PRIVILEGES;"

# ============================================
# 📂 کلون کردن ربات
# ============================================
RUN cd /var/www && git clone https://github.com/mahdiMGF2/mirzabot.git mirza_bot \
    && cd /var/www/mirza_bot \
    && composer install

# ============================================
# 📝 ساخت فایل تنظیمات
# ============================================
RUN cat > /var/www/mirza_bot/config.php << 'CONFIG'
<?php
$dbhost = 'localhost';
$dbname = 'mirza_pro';
$usernamedb = 'mirza_user';
$passworddb = 'Mirza@2026!Secure';

$options = [
    PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
    PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
    PDO::ATTR_EMULATE_PREPARES => false,
    PDO::MYSQL_ATTR_INIT_COMMAND => "SET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci",
];

$dsn = "mysql:host=$dbhost;dbname=$dbname;charset=utf8mb4";
try {
    $pdo = new PDO($dsn, $usernamedb, $passworddb, $options);
} catch (PDOException $e) {
    error_log("Database connection failed: " . $e->getMessage());
    die("error: database connection failed");
}

$APIKEY = '{YOUR_BOT_TOKEN}';
$adminnumber = '{YOUR_ADMIN_ID}';
$domainhosts = '{YOUR_DOMAIN}';
$usernamebot = '{YOUR_BOT_NAME}';
?>
CONFIG

# ============================================
# 📝 ساخت اسکریپت ریستارت
# ============================================
RUN cat > /root/restart.sh << 'RESTART'
#!/bin/bash
echo "🔄 شروع راه‌اندازی مجدد..."

# استارت سرویس‌ها
service mariadb start 2>/dev/null
service apache2 start 2>/dev/null
service cron start 2>/dev/null
service ssh start 2>/dev/null

# Kill تونل‌های قبلی
pkill -9 cloudflared 2>/dev/null
sleep 2

# راه‌اندازی تونل جدید
cloudflared tunnel --url http://localhost:80 > /tmp/tunnel.log 2>&1 &
sleep 15

# دریافت آدرس جدید
TUNNEL_URL=$(grep -oP 'https://[a-zA-Z0-9\-]+\.trycloudflare\.com' /tmp/tunnel.log | head -1)

if [ -z "$TUNNEL_URL" ]; then
    echo "❌ خطا: آدرس تونل پیدا نشد!"
    exit 1
fi

echo "✅ آدرس جدید تونل: $TUNNEL_URL"

# آپدیت config.php
sed -i "s|{YOUR_DOMAIN}|$TUNNEL_URL|g" /var/www/mirza_bot/config.php

# آپدیت Webhook
curl -s "https://api.telegram.org/bot{YOUR_BOT_TOKEN}/deleteWebhook" > /dev/null
curl -s "https://api.telegram.org/bot{YOUR_BOT_TOKEN}/setWebhook?url=$TUNNEL_URL/index" > /dev/null

echo "✅ راه‌اندازی مجدد تمام شد!"
echo "🔗 آدرس ربات: $TUNNEL_URL"
RESTART
chmod +x /root/restart.sh

# ============================================
# 📝 ساخت اسکریپت مانیتورینگ
# ============================================
RUN cat > /root/monitor.sh << 'MONITOR'
#!/bin/bash
while true; do
    # چک کردن Apache
    if ! pgrep -x "apache2" > /dev/null; then
        echo "❌ Apache خاموش شده - ریستارت میکنم..."
        service apache2 start
    fi
    
    # چک کردن MariaDB
    if ! pgrep -x "mariadbd" > /dev/null; then
        echo "❌ MariaDB خاموش شده - ریستارت میکنم..."
        service mariadb start
    fi
    
    # چک کردن Cloudflared
    if ! pgrep -x "cloudflared" > /dev/null; then
        echo "❌ Cloudflared خاموش شده - ریستارت میکنم..."
        cloudflared tunnel --url http://localhost:80 > /tmp/tunnel.log 2>&1 &
        sleep 15
        TUNNEL_URL=$(grep -oP 'https://[a-zA-Z0-9\-]+\.trycloudflare\.com' /tmp/tunnel.log | head -1)
        if [ ! -z "$TUNNEL_URL" ]; then
            curl -s "https://api.telegram.org/bot{YOUR_BOT_TOKEN}/setWebhook?url=$TUNNEL_URL/index" > /dev/null
        fi
    fi
    
    sleep 300  # هر ۵ دقیقه چک کن
done
MONITOR
chmod +x /root/monitor.sh

# ============================================
# 🚀 نقطه شروع
# ============================================
CMD ["/bin/bash", "-c", "service mariadb start && service apache2 start && service cron start && service ssh start && tail -f /dev/null"]

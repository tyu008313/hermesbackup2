#!/usr/bin/env bash
# ============================================================
#  HERMES BRAIN BACKUP — Master Orchestrator (TEMPLATE)
#  Copy me, replace <PLACEHOLDERS>, keep the stage order.
#  Runs WITHOUT any LLM. Zero tokens. Exit code = health.
# ============================================================
set -uo pipefail

export HOME=/data                       # <- your agent home root
export GIT_TERMINAL_PROMPT=0
TOKEN="<GITHUB_PAT>"                    # keep OUT of command lines; file-only
REMOTE="https://x-access-token:${TOKEN}@github.com/<OWNER>/<REPO>.git"
REPO_DIR="/data/workspace/backup_repo"  # local mirror checkout
SCRIPTS="/data/workspace/backup_scripts"
LOCK="/tmp/hermes_backup.lock"
LOG="/data/workspace/backup.log"

# scrub exact literals in use (belt-and-suspenders beyond regex patterns)
export HERMES_SCRUB_LITERALS="<GITHUB_PAT>"

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOG"; }

# ---------- single-instance lock ----------
if [ -f "$LOCK" ] && kill -0 "$(cat $LOCK)" 2>/dev/null; then
    log "SKIP: another backup is running"; exit 0
fi
echo $$ > "$LOCK"
trap 'rm -f "$LOCK"' EXIT

log "========== BACKUP RUN START =========="
mkdir -p "$REPO_DIR"

log "[1/5] exporting sessions ..."
python3 "$SCRIPTS/export_sessions.py"   >> "$LOG" 2>&1 \
    && log "      sessions OK" || log "      !! session exporter FAILED (continuing)"

log "[2/5] exporting assets + scrub ..."
python3 "$SCRIPTS/export_assets.py"     >> "$LOG" 2>&1 \
    && log "      assets OK"    || log "      !! asset exporter FAILED (continuing)"

log "[3/5] writing docs ..."
python3 "$SCRIPTS/write_docs.py"        >> "$LOG" 2>&1 \
    && log "      docs OK"      || log "      !! docs writer failed"

log "[4/5] building dashboard ..."
python3 "$SCRIPTS/build_dashboard.py"   >> "$LOG" 2>&1 \
    && log "      dashboard OK" || log "      !! dashboard FAILED"

# ---------- 5) mirror commit + push ----------
cd "$REPO_DIR" || exit 1
git remote remove origin 2>/dev/null
git remote add origin "$REMOTE"
# adopt remote history AND stage true mirror-state:
git fetch origin main --quiet 2>>"$LOG" \
    && git reset --mixed FETCH_HEAD 2>>"$LOG"    # index=remote HEAD, worktree ours

git add -A                                  # stages deletions too
STAGED=$(git diff --cached --numstat | wc -l)
if [ "$STAGED" -eq 0 ]; then
    log "NOTHING NEW — repo already in sync. done."
    exit 0
fi

git commit -q -m "backup: auto-sync $(date -u '+%Y-%m-%d %H:%M UTC') [no-llm]" \
    || { log "nothing to commit after all"; exit 0; }

log "[5/5] pushing $STAGED changed files ..."
if git push origin main --quiet 2>>"$LOG"; then
    log "PUSH OK → $(git rev-parse --short HEAD) ($STAGED files)"
else
    sleep 3
    git pull --rebase origin main >> "$LOG" 2>&1
    if git push origin main --quiet 2>>"$LOG"; then
        log "PUSH OK (retry) → $(git rev-parse --short HEAD)"
    else
        log "!! PUSH FAILED — will retry on next run"
        exit 1
    fi
fi
log "========== BACKUP RUN END =========="
